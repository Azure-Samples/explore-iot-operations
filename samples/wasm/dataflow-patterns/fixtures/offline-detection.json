    {
      "topic":"factory/register","nowMs":2600,
      "input":{"kind":"register","assetId":"sensor-3"},
      "expected":null
    },
    {
      "topic":"factory/readings","nowMs":2700,
      "input":{"kind":"reading","assetId":"sensor-3","messageId":"r0","sequence":0,"value":30},
      "expected":{"kind":"availability","assetId":"sensor-3","state":"online","reason":"firstReading","emittedAtMs":2700,"lastSeenAtMs":2700,"elapsedMs":0}
