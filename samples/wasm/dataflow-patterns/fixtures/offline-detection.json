{
  "configuration": {"role":"offline-detection","timeoutMs":1000},
  "steps": [
    {
      "topic":"factory/ticks","nowMs":0,
      "input":{"kind":"tick","assetId":"unknown"},
      "expected":null
    },
    {
      "topic":"factory/register","nowMs":100,
      "input":{"kind":"register","assetId":"sensor-1"},
      "expected":null
    },
    {
      "topic":"factory/register","nowMs":500,
      "input":{"kind":"register","assetId":"sensor-1"},
      "expected":null
    },
    {
      "topic":"factory/ticks","nowMs":1099,
      "input":{"kind":"tick","assetId":"sensor-1"},
      "expected":null
    },
    {
      "topic":"factory/ticks","nowMs":1100,
      "input":{"kind":"tick","assetId":"sensor-1"},
      "expected":{"kind":"availability","assetId":"sensor-1","state":"offline","reason":"timeout","emittedAtMs":1100,"lastSeenAtMs":null,"elapsedMs":1000}
    },
    {
      "topic":"factory/ticks","nowMs":1200,
      "input":{"kind":"tick","assetId":"sensor-1"},
      "expected":null
