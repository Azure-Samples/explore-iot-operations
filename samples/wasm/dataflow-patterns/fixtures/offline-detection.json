    {
      "topic":"factory/readings","nowMs":1300,
      "input":{"kind":"reading","assetId":"sensor-1","messageId":"r0","sequence":0,"value":10},
      "expected":{"kind":"availability","assetId":"sensor-1","state":"online","reason":"recovered","emittedAtMs":1300,"lastSeenAtMs":1300,"elapsedMs":1200}
    },
    {
      "topic":"factory/readings","nowMs":1400,
      "input":{"kind":"reading","assetId":"sensor-1","messageId":"r1","sequence":1,"value":11},
      "expected":null
    },
    {
      "topic":"factory/readings","nowMs":2000,
      "input":{"kind":"reading","assetId":"sensor-1","messageId":"r1","sequence":1,"value":11},
      "expected":null
    },
    {
      "topic":"factory/readings","nowMs":2400,
      "input":{"kind":"reading","assetId":"sensor-1","messageId":"r2","sequence":2,"value":12},
      "expected":{"kind":"batch","records":[
        {"kind":"availability","assetId":"sensor-1","state":"offline","reason":"timeout","emittedAtMs":2400,"lastSeenAtMs":1400,"elapsedMs":1000},
        {"kind":"availability","assetId":"sensor-1","state":"online","reason":"recovered","emittedAtMs":2400,"lastSeenAtMs":2400,"elapsedMs":1000}
      ]}
    },
    {
      "topic":"factory/readings","nowMs":2500,
      "input":{"kind":"reading","assetId":"sensor-2","messageId":"r0","sequence":0,"value":20},
      "expected":{"kind":"availability","assetId":"sensor-2","state":"online","reason":"firstReading","emittedAtMs":2500,"lastSeenAtMs":2500,"elapsedMs":0}
